      (width 32)
      (height 224)
      (oneshot #t)
      (script "Tux.deactivate();
Effect.sixteen_to_nine(0);
Tux.walk(100);
Effect.fade_in(1.5);
wait(0.5);
Text.set_text(_(\"This is where Tux's journey in Rob's Forest comes to an end.\"));
Text.fade_in(1);
wait(5);
Text.fade_out(2);
Text.set_text(_(\"Thank you all for playing!\"));
Text.fade_in(1);
wait(3);
Text.fade_out(2);
Text.set_text(_(\"Hope to see you all in a new adventure!\"));
Text.fade_in(1);
wait(3);
Text.fade_out(2);
Text.set_text(_(\"Special thanks to: Servalot, Semphris, Narre, Vankata for helping me out and making this possible.\"));
Text.fade_in(1);
wait(5);
Text.fade_out(2.5);
wait(0.5);
Effect.fade_out(2);
wait(3);
Level.finish(true);")
