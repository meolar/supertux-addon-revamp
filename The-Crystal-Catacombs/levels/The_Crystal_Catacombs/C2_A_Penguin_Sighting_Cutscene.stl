(supertux-level
  (version 3)
  (name (_ "A Penguin Sighting"))
  (author "Alasdair, Semphris")
  (contact "Discord: Servalot#1701")
  (license "CC-BY-SA 4.0 International")
  (sector
    (name "main")
    (init-script "
start_cutscene();
Tux.deactivate();
Effect.fade_out(0);
Camera.set_mode(\"scroll\");
Effect.sixteen_to_nine(0);
sector.Camera.set_pos(0, 1000);
Yeti.set_action(\"stand-left\");
Camera.scroll_to(700, 820, 6);
Effect.fade_in(1.5);
wait(3);
Yeti.set_action(\"stomp-left\");
play_sound(\"sounds/yeti_gna.wav\");
Yeti.set_velocity(0, -300);
wait(0.5);
Yeti.set_action(\"stand-left\");
Text.set_text(\"The Yeti seems to have noticed Tux from a Watchtower.\");
Text.fade_in(1);
play_sound(\"sounds/yeti_roar.wav\");
wait(2.5);
Yeti.set_action(\"stand-right\");
play_sound(\"sounds/yeti_roar.wav\");
wait(0.25);
Yeti.set_action(\"walking-right\");
Yeti.set_velocity(250, 0);
wait(0.75);
Text.fade_out(1);
Yeti.set_action(\"jump-right\");
Yeti.set_velocity(300, -450);
wait(2);
play_sound(\"sounds/explosion.wav\");
wait(0.017);
play_sound(\"sounds/explosion.wav\");
wait(0.1);
play_sound(\"sounds/explosion.wav\");
for (local i=0.0;i<100.0;i+=1.0)
{
  local x = (rand()/2147483647.0*64.0-32.0)*(1.0-i/100.0);
  local y = (rand()/2147483647.0*64.0-32.0)*(1.0-i/100.0);
  Camera.shake(0.017, x, y);
  wait(0.017);
}
wait(1);
Text.set_text(\"... but it seems like the Yeti has made his own way out.\");
Text.fade_in(1);
wait(3);
Text.fade_out(1);
wait(1.4);
Effect.fade_out(2.5);
wait(2.5);
end_cutscene();
Level.finish(true);")
    (ambient-light
      (color 1 1 1)
    )
    (background
      (color 1 1 1)
      (speed 0.5)
      (image-top "/images/background/nightsky/nightsky_top.png")
      (image "/images/background/nightsky/nightsky_top.png")
      (image-bottom "/images/background/nightsky/nightsky_top.png")
    )
    (camera
      (name "Camera")
      (mode "normal")
    )
    (gradient
      (blend "mod")
      (top_color 0.7 0.7 0.7)
      (bottom_color 0.7 0.7 0.7)
      (z-pos -240)
    )
    (music
      (file "/music/misc/bonuscave.music")
    )
    (particles-clouds
      (z-pos -250)
    )
    (scriptedobject
      (name "Yeti")
      (sprite "/images/creatures/yeti/yeti.sprite")
      (x 1600)
      (y 1152)
    )
    (spawnpoint
      (name "main")
      (x 0)
      (y 800)
    )
    (tilemap
      (solid #f)
      (z-pos -100)
      (width 200)
      (height 80)
      (tiles
