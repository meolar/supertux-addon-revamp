    (pushbutton
      (script "
Tux.deactivate();
for(local a=0;a<10;a+=1) {
Camera.shake(0.1, 0, a);
wait(0.1);
}
Effect.sixteen_to_nine(1);
Camera.set_mode(\"manual\");
Stopper.fade(0, 0);
waterfalls1.goto_node(1);
wait(1);
Camera.scroll_to(10450, 0, 3);
wait(4);
MOVINGwater.goto_node(1);
ptwo.goto_node(1);
pthree.goto_node(1);
wait(0.5);
Camera.scroll_to(10400, 1100, 2);
wait(5);
Effect.four_to_three(1);
Camera.set_mode(\"normal\");
Tux.activate();
this.lightupdate_active <- false
wait(5);
waterfalls1.fade(0, 0);
waterfalls2.fade(0.7, 0);
")
      (x 9568)
      (y 276)
    )
    (scripttrigger
      (width 32)
      (height 512)
      (oneshot #t)
      (script "
start_cutscene();
Tux.deactivate();
Effect.sixteen_to_nine(1);
Camera.set_mode(\"manual\");
Camera.scroll_to(10000, 1200, 4);
wait(2);
Text.set_text(\"TUX: The Yeti must have drained this basin, I'll need to fill it up again.\");
Text.fade_in(1);
wait(5);
Text.fade_out(1);
Camera.scroll_to(10860, 595, 4);
wait(2);
Text.set_text(\"TUX: ... to get out of here and head towards the catacombs...\");
Text.fade_in(1);
wait(5);
Text.fade_out(1);
Camera.scroll_to(10400, 0, 4);
wait(5);
Camera.scroll_to(9260, 40, 4);
Text.set_text(\"TUX: Maybe that button will do something?\");
Text.fade_in(1);
wait(4);
Camera.scroll_to(8595, 100, 3);
wait(4);
finaldoor.start_moving();
Text.fade_out(1);
wait(2);
Camera.scroll_to(9700, 615, 3);
wait(4);
Effect.four_to_three(1.5);
Camera.set_mode(\"normal\");
Tux.activate();
end_cutscene();
")
      (button #f)
      (x 10336)
      (y 576)
