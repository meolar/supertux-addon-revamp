    (scripttrigger
      (width 56)
      (height 8)
      (oneshot #t)
      (script "
start_cutscene();
Tux.deactivate();
Effect.sixteen_to_nine(1);
wait(0.2);
Tux.set_dir(true);
Tux.walk(50);
wait(0.5);
Tux.walk(0);
wait(0.5);
Text.set_text(\"Tux has found an old note, it seemed to be a ripped page from a diary.\");
Text.fade_in(1);
wait(3.5);
Text.fade_out(1);
wait(2);
Text.set_text(\"DIARY: The Crystals feel cold and sharp, the antethesis of healing.\");
Text.fade_in(0.9);
wait(6);
Text.fade_out(1);
wait(1);
Text.set_text(\"DIARY: All of this journey... and for what? To see a grave that will never open again? This place is cruel. Revival is an empty promise...\");
Text.fade_in(1);
wait(7);
Text.fade_out(1);
wait(2);
Effect.four_to_three(1);
Tux.activate();
end_cutscene();
")
