(supertux-level
  (version 3)
  (name (_ "The Legend"))
  (author "Alasdair")
  (contact "Discord: Servalot#1701")
  (license "CC-BY-SA 4.0 International")
  (sector
    (name "main")
    (init-script "
start_cutscene();
Tux.deactivate();
Effect.sixteen_to_nine(0);
sector.Camera.set_pos(0, 850);
Camera.set_mode(\"scroll\");
settings.fade_to_ambient_light(0.7, 0.7, 0.7, 17);
Effect.fade_in(2);
Camera.scroll_to(1150, 1750, 14);
wait(2);
Tux.add_bonus(\"grow\");
Tux.walk(140);
Text.set_text(\"Somewhere on the shores of Antarctica, in an alternate timeline...\");
Text.fade_in(1);
wait(3);
Text.fade_out(1);
wait(2);
Text.set_text(\"Tux was on his way home from a day out.\");
Tux.walk(180);
Text.fade_in(1);
wait(2);
Text.fade_out(1);
wait(4.5);
Tux.do_jump(-500);
wait(0.7);
Tux.walk(0);
DOOR.set_action(\"open\");
play_sound(\"sounds/door.wav\");
Effect.fade_out(1);
Tux.use_scripting_controller(false);
wait(2);
Level.spawn(\"scroll\", \"main\");")
