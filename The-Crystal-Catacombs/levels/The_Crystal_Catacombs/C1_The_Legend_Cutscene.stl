  (sector
    (name "main2")
    (init-script "Effect.sixteen_to_nine(0.1);
Effect.fade_in(1);
Tux.deactivate();
settings.fade_to_ambient_light(0.3, 0.3, 0.3, 52);
grad1.fade_colors(0.1,0.2,0.4,0.0,0.1,0.2,52);
DOOR.set_action(\"open\");
wait(1);
DOOR.set_action(\"closed\");
wait(1);
Text.set_text(\"As Tux arrived home, he noticed he had some mail.\");
Text.fade_in(1);
wait(1.5);
Tux.walk(20);
wait(1.5);
Tux.walk(0);
wait(0.5);
Text.fade_out(1);
wait(1.5);
Text.set_text(\"It was an invite to the Crystal Festival. Attached was a poem of the old Legend, it read...\");
Text.fade_in(1);
wait(4);
Text.fade_out(1);
wait(1);
Text.set_text(\"There once was a penguin, From a land not afar,\");
Text.fade_in(1);
wait(3);
Text.fade_out(1);
wait(1);
Text.set_text(\"his life was taken, in bloody battles, scarred\");
Text.fade_in(1);
wait(3);
Text.fade_out(1);
wait(1);
Text.set_text(\"and as his body laid, penguins alike shed tears,\");
Text.fade_in(1);
wait(3);
Text.fade_out(1);
wait(1);
Text.set_text(\"memory soon would fade, crystals would hold him dear.\");
Text.fade_in(1);
wait(3);
Text.fade_out(1);
wait(1);
Text.set_text(\"Years and years would drift by, until one dreary day,\");
Text.fade_in(1);
wait(3);
Text.fade_out(1);
wait(1);
Text.set_text(\"The Penguin was alive, celebrations were made.\");
Text.fade_in(1);
wait(4);
Text.fade_out(1);
wait(2);
Text.set_text(\"Tux sighed and looked out of the window at the empty abyss\");
Text.fade_in(1);
wait(3);
Text.fade_out(1);
wait(1);
Text.set_text(\"TUX: Penny was buried in the Catacombs, amongst the crystals, just like that old Legend.\");
Text.fade_in(1);
wait(3);
Text.fade_out(1);
wait(2);
Tux.set_dir(true);
wait(1);
Text.set_text(\"TUX: If only that Legend was true, I could see my Penny once again...\");
Text.fade_in(1);
wait(4);
Text.fade_out(1);
wait(2);
Effect.fade_out(2);
wait(2);
Level.spawn(\"main3\", \"main\");")
