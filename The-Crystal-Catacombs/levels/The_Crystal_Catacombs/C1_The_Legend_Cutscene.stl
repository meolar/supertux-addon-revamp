  (sector
    (name "scroll")
    (init-script "
Effect.fade_out(0);
Effect.sixteen_to_nine(0);
Camera.set_mode(\"scroll\");
sector.Camera.set_pos(0,1232);
Camera.scroll_to(3536, 1232, 32);
wait(1);
Effect.fade_in(1);
wait(2);
Text.set_text(\"It had been months since Penny died in the crossfire between Tux and Nolok's ultimate battle.\");
Text.fade_in(1);
wait(4);
Text.fade_out(1);
wait(1);
Text.set_text(\"Tux would claim his victory, but Penny would claim her funeral.\");
Text.fade_in(1);
wait(6);
Text.fade_out(1);
wait(1);
Text.set_text(\"Tux wouldn't attend her funeral out of shame. So like any penguin, Penny was buried deep, deep within...\");
Text.fade_in(1);
wait(6);
Text.fade_out(1);
wait(1);
Text.set_text(\"THE CRYSTAL CATACOMBS\");
Text.fade_in(1);
wait(4);
Text.fade_out(1);
wait(0.5);
Effect.fade_out(1);
wait(1.5);
Level.spawn(\"main2\", \"main\");")
