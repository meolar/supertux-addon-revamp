  (sector
    (name "main3")
    (init-script "Effect.fade_out(0);
wait(3);
Camera.set_mode(\"manual\");
Tux.deactivate();
Effect.sixteen_to_nine(0.1);
wait(0.15);
Effect.fade_in(2);
wait(2);
Text.set_text(\"The next morning, Tux was woken early by more mail at the door!\");
Text.fade_in(1);
wait(3);
Text.fade_out(1);
wait(1);
Effect.fade_out(1);
wait(1.5);
warp(0, -5);
Tux.set_dir(false);
Effect.fade_in(1);
wait(1);
Text.set_text(\"The Letter read...\");
Text.fade_in(1);
wait(2);
Text.fade_out(1);
wait(1.5);
Text.set_text(\"Tux! Please hurry to The Crystal Catacombs! The Yeti has stormed the tunnels and laid his evil minions everywhere!\");
Text.fade_in(1);
wait(6);
Text.fade_out(1);
wait(1.5);
Text.set_text(\"He could even be at Penny's Grave! You must defeat him!\");
Text.fade_in(1);
wait(3);
Text.fade_out(1);
wait(1.5);
Text.set_text(\"The celebrations have been cancelled. We're counting on you Tux!\");
Text.fade_in(1);
wait(3);
Text.fade_out(1);
Tux.set_dir(true);
wait(2);
Text.set_text(\"Tux looked back in disbelief, but didn't hesitate. He knew what he had to do next.\");
Text.fade_in(1);
stop_music(8);
wait(3);
Tux.set_dir(false);
wait(2);
Effect.fade_out(2);
wait(1);
Text.fade_out(1);
wait(2.5);
end_cutscene();
