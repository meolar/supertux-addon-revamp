    (name "main4")
    (init-script "
Effect.fade_out(0);
PENNY6.set_action(\"stand-right\");
Camera.set_mode(\"scroll\");
Camera.set_pos(650,1150);
Camera.scroll_to(430,1150,10);
Tux.deactivate();
Tux.set_dir(false);
Tux.walk(-100);
Effect.fade_in(1);
wait(2);
Text.set_text(\"Tux and Penny left the catacombs together, A tear in both's eyes.\");
Text.fade_in(1);
wait(3);
Text.fade_out(1);
wait(1);
Tux.walk(0);
wait(0.5);
Text.set_text(\"TUX: ... and thats the whole story! The Legend was true after all, and now I have you back!\");
Text.fade_in(1);
wait(0.5);
Tux.do_jump(-400);
wait(1.2);
Tux.do_duck();
wait(0.016);
Tux.do_backflip();
wait(1.3);
Tux.do_jump(-300);
wait(0.5);
Tux.do_jump(-300);
Text.fade_out(1);
wait(0.5);
Tux.walk(-100);
wait(0.5);
Effect.fade_out(1);
wait(1);
Tux.walk(0);
Level.spawn(\"main5\",\"main\");
