  (sector
    (name "main2")
    (init-script "
Tux.deactivate();
Effect.sixteen_to_nine(0);
sector.Camera.set_mode(\"scroll\");
Camera.set_pos(540,750);
Tux.set_dir(false);
PENNY.set_action(\"stand-right\");
Text.set_text(\"And like that, Tux's journey had come to an end.\");
Text.fade_in(1);
wait(3);
// music fade in
Text.fade_out(1);
wait(1);
white.fade(0,0.7);
settings.fade_to_ambient_light(0.8,1,0.7,0.7);
wait(1.5);
Text.set_text(\"TUX: Penny!\");
Text.fade_in(1);
wait(1);
Tux.do_jump(-300);
wait(1);
Text.fade_out(1);
wait(1.5);
Text.set_text(\"PENNY: Tux! Where... where am I?\");
Text.fade_in(1);
wait(1);
PENNY.set_action(\"stand-left\");
wait(1);
PENNY.set_action(\"stand-right\");
wait(1);
Text.fade_out(1);
wait(1.5);
Text.set_text(\"TUX: Quick, come with me, I can explain as we get out of here...\");
Text.fade_in(1);
wait(0.5);
Tux.walk(-130);
wait(0.5);
Effect.fade_out(3);
wait(0.5);
Tux.walk(0);
wait(2.5);
Text.fade_out(1);
wait(1);
end_cutscene();
wait(1);
Level.spawn(\"main3\",\"main\");")
