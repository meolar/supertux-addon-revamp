(supertux-level
  (version 3)
  (name (_ "The Revival"))
  (author "Alasdair")
  (license "CC-BY-SA 4.0 International")
  (sector
    (name "main")
    (init-script "
function waitnshake(time) {
  for (local i = 0; i < time / 0.1; i++) {
    local x = rand() % 9 - 4;
    local y = rand() % 9 - 4;
    sector.Camera.shake(0.05, x, y);
    wait(0.05);
    sector.Camera.shake(0.05, -x, -y);
    wait(0.05);
  }
}

Effect.fade_out(0);
Tux.deactivate();
Tux.set_dir(false);
Effect.sixteen_to_nine(0);
sector.Camera.set_mode(\"scroll\");
Camera.set_pos(1212,650);
Camera.scroll_to(640,700,14);
Effect.fade_in(1);
Tux.walk(-150);
wait(1.2);
Text.set_text(\"Tux returned to the Palace tomb\");
Text.fade_in(1);
wait(1.6);
Tux.do_jump(-450);
wait(2.5);
Text.fade_out(1);
wait(0.4);
Tux.walk(0);
wait(1);
Tux.set_dir(true);
wait(0.3);
Text.set_text(\"Looking back on Nolok's Grave, Tux turned around to his beloved Penny.\");
Text.fade_in(1);
wait(1.7);
Tux.set_dir(false);
wait(0.5);
Tux.walk(-110);
wait(1.4);
Tux.walk(0);
wait(0.5);
Text.fade_out(1);
wait(2);
Text.set_text(\"Now radiating with Hero Energy, Tux breathed in deeply and waited.\");
Text.fade_in(1);
wait(4);
Text.fade_out(1);
wait(1.4);
Text.set_text(\"As the ground underneath him shook, the crystals arranged themselves, and held Penny dear...\");
Text.fade_in(1);
waitnshake(1);
Camera.scroll_to(540,750,4);
c1.start_moving();
waitnshake(1.6);
c2.start_moving();
waitnshake(1.4);
c3.start_moving();
waitnshake(1);
c4.start_moving();
waitnshake(0.2);
c5.start_moving();
waitnshake(0.6);
c6.start_moving();
waitnshake(0.2);
c7.start_moving();
waitnshake(0.3);
c8.start_moving();
c9.start_moving();
waitnshake(0.2);
Text.fade_out(1);
waitnshake(0.1);
c10.start_moving();
c11.start_moving();
waitnshake(0.1);
c12.start_moving();
waitnshake(0.2);
c13.start_moving();
c14.start_moving();
waitnshake(0.1);
c15.start_moving();
waitnshake(0.3);
c16.start_moving();
waitnshake(0.1);
c17.start_moving();
stop_music(3.5);
waitnshake(1);
white.fade(1,3);
settings.fade_to_ambient_light(1,1,1,1);
waitnshake(3);
Level.spawn(\"main2\",\"main\");")
