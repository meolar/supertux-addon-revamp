    (name "main")
    (init-script "wait(5.5);
while(true)  {
 Effect.fade_out(0.5);
 wait(0.5);
 Level.flip_vertically();
 Effect.fade_in(0.5);
 wait(5.5);
 Effect.fade_out(0.5);
 wait(0.5);
 Level.flip_vertically();
 Effect.fade_in(0.5);
 wait(5.5);
 }")
