    (scripttrigger
      (width 64)
      (height 16)
      (oneshot #t)
      (script "
Effect.sixteen_to_nine(1);
Tux.deactivate();
wait(1);
Text.set_text(\"Tux had found another mysterious diary entry.\");
Text.fade_in(1);
wait(3);
Text.fade_out(1);
wait(2);
Text.set_text(\"This area is probably the peak of bizzare. The catacombs are full of strange places...\");
Text.fade_in(1);
wait(4);
Text.fade_out(1);
wait(2);
Text.set_text(\"... but this? Stuck in Purgatory, I feel. If you are reading this, it is likely I have met my fate.\");
Text.fade_in(1);
wait(5);
Text.fade_out(1);
wait(2);
Effect.four_to_three(1);
Tux.activate();
")
