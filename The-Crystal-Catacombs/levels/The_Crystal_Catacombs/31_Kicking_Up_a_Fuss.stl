    (scripttrigger
      (width 32)
      (height 304)
      (script "start_cutscene();
settings.fade_to_ambient_light(1,0.9,1,2);
Tux.deactivate();
Effect.sixteen_to_nine(1);
Tux.set_dir(true);
Tux.walk(80);
wait(3);
Tux.walk(0);
wait(0.8);
Tux.set_dir(false);
wait(2);
Tux.set_dir(true);
Text.set_text(\"Tux was shocked by what he saw...\");
Text.fade_in(1);
wait(3);
Text.fade_out(1);
Tux.walk(70);
wait(1);
Text.set_text(\"Somehow there seemed to be a forest of life growing around Tux...\");
Text.fade_in(1);
wait(3);
Tux.walk(0);
wait(1);
Tux.set_dir(false);
Text.fade_out(1);
wait(1);
Text.set_text(\"TUX: This place seems to be getting stranger and stranger...\");
Text.fade_in(1);
Tux.set_dir(true);
wait(1.5);
stop_music(4.5);
wait(1.5);
Tux.walk(150);
wait(0.5);
Tux.do_jump(-300);
Text.fade_out(1);
wait(1);
Effect.fade_out(1);
wait(2);
end_cutscene();
Level.finish(true);")
