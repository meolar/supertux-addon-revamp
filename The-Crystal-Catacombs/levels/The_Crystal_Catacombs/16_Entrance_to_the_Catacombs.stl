    (scripttrigger
      (width 32)
      (height 480)
      (oneshot #t)
      (script "Effect.sixteen_to_nine(1.5);
stop_music(5);
Tux.deactivate();
Tux.do_standup();
Tux.set_dir(true)
Tux.walk(80);
wait(3);
Tux.walk(0);
wait(1);
Tux.set_dir(false);
Text.set_text(\"After a long trek, Tux had finally made it to the catacombs' entrance.\");
Text.fade_in(1);
wait(3);
Tux.set_dir(true);
wait(1.5);
Text.fade_out(1);
Tux.walk(120);
wait(0.15);
Tux.do_jump(-300);
wait(2);
Tux.walk(50);
wait(0.2);
Tux.walk(0);
wait(0.8);
Text.set_text(\"Little did Tux know, this only marked the beginning of his forward adventure.\");
Text.fade_in(1);
wait(3);
Tux.walk(110);
wait(1.5);
Tux.do_jump(-400);
wait(1);
Effect.fade_out(1);
wait(0.3);
Text.fade_out(0.8);
wait(2.3);
Level.finish(true);")
