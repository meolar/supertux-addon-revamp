    (scripttrigger
      (width 48)
      (height 16)
      (oneshot #t)
      (script "
start_cutscene();
Tux.deactivate();
Effect.sixteen_to_nine(1);
wait(1);
Tux.set_dir(true);
Tux.walk(50);
wait(0.5);
Tux.walk(0);
wait(1);
Text.set_text(\"Tux seemed to have stumbled across another Diary page...\");
Text.fade_in(1);
wait(3);
Text.fade_out(1);
wait(2);
Text.set_text(\"DIARY: The Catacombs are endless and vast. Thousands of graves enshrined with crystals accompanied my journey here.\");
Text.fade_in(1);
wait(4);
Text.fade_out(1);
wait(2);
Text.set_text(\"DIARY: But all are sealed nonetheless. The Legend is nothing but a falsehood.\");
Text.fade_in(1);
wait(3.5);
Text.fade_out(1);
wait(1.5);
Effect.four_to_three(1);
Tux.activate();
end_cutscene();
")
