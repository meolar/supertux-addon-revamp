(supertux-level
  (version 3)
  (name (_ "A Yeti in the Bushes"))
  (author "Alasdair")
  (license "CC-BY-SA 4.0 International")
  (sector
    (name "main")
    (init-script "
start_cutscene();
Effect.fade_out(0);
Tux.deactivate();
Camera.set_mode(\"scroll\");
sector.Camera.set_pos(0,580);
Effect.sixteen_to_nine(0);
YETI.set_action(\"stand-left\");
Effect.fade_in(1);
Tux.walk(100);
wait(1);
Tux.walk(0);
wait(1);
Text.set_text(\"As Tux approached what appeared to be an altar, he suddenly realised something grand.\");
Text.fade_in(1);
wait(2);
Tux.set_dir(false);
wait(2);
Text.fade_out(1);
wait(2);
Text.set_text(\"TUX: All of this pasture, all of this life surrounding me, has grown through my journey.\");
Text.fade_in(1);
wait(1);
Tux.set_dir(true);
wait(3);
Text.fade_out(1);
wait(2);
Text.set_text(\"TUX: Surely this must mean that... the crystals can support life? But how, just in the presence of me...?\");
Text.fade_in(1);
wait(4);
Text.fade_out(1);
wait(1.2);
Camera.scroll_to(760,420,0.5);
stop_music(0.5);
wait(0.5);
play_music(\"music/antarctic/voc-boss.music\");
wait(0.3);
YETI.set_action(\"stomp-left\");
Text.set_text(\"YETI: Have you finally figured it out, Tux?\");
Text.fade_in(1);
wait(1);
Tux.walk(200);
wait(1);
YETI.set_action(\"stand-left\");
wait(1);
Text.fade_out(1);
Camera.scroll_to(530,440,2);
wait(1);
Tux.walk(0);
wait(0.2);
Tux.do_jump(-100);
Text.set_text(\"TUX: Yeti! What are you doing to my beloved Penny!\");
Text.fade_in(1);
wait(0.5);
Tux.do_jump(0);
wait(2);
Camera.scroll_to(760,420,1);
wait(0.5);
Text.fade_out(1);
wait(2);
Text.set_text(\"The Yeti just laughed.\");
Text.fade_in(1);
play_sound(\"sounds/yeti_roar.wav\");
wait(1);
YETI.set_action(\"stomp-left\");
YETI.set_velocity(0,-300);
wait(0.5);
YETI.set_action(\"stand-left\");
wait(0.5);
Text.fade_out(1);
wait(1.5);
Text.set_text(\"YETI: Why dont you find out for yourself! You can find me at the end of the Crystal Palace! Her grave is in such peril, Tux!\");
Text.fade_in(1);
wait(1);
YETI.set_action(\"stand-right\");
wait(0.3);
YETI.set_action(\"walking-right\");
YETI.set_velocity(225,0);
wait(1);
YETI.set_action(\"stomp-right\");
play_sound(\"sounds/yeti_gna.wav\");
YETI.set_velocity(225,-300);
Camera.scroll_to(530,460,2);
wait(0.1);
YETI.set_action(\"walking-right\");
wait(0.4);
YETI.set_velocity(225,0);
Text.fade_out(1);
wait(1.2);
stop_music(3.2);
Tux.walk(60);
wait(1.5);
Tux.walk(0);
wait(0.2);
Tux.set_dir(false);
wait(1.5);
play_music(\"music/antarctic/arctic_cave.music\");
Text.set_text(\"Tux was shocked. How could the Yeti do something this evil? He knew his destiny neared, so, once again, he did what he knew best.\");
Text.fade_in(1);
wait(3);
Tux.set_dir(true);
wait(2);
Text.fade_out(1);
wait(0.2);
Tux.walk(260);
wait(0.36);
Tux.do_jump(-605);
wait(0.95);
Tux.do_jump(-400);
wait(1);
Text.set_text(\"He chased.\");
Text.fade_in(1);
wait(2);
Effect.fade_out(1);
wait(2);
Text.fade_out(1);
wait(2);
end_cutscene();
Level.finish(true);")
    (ambient-light
      (color 0.8 1 0.8)
    )
    (background
      (color 1 1 1)
      (speed 0.4)
      (image-top "/images/background/ice_cave/darkcave-background.png")
