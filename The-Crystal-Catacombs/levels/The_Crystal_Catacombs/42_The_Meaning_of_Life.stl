  (sector
    (name "main2")
    (init-script "
start_cutscene();
Effect.fade_out(0);
Tux.deactivate();
Effect.sixteen_to_nine(0);
YETI.set_action(\"stand-left\");
sector.Camera.set_mode(\"scroll\");
Camera.set_pos(0,525);
Camera.scroll_to(95,621,2.2);
Tux.walk(120);
wait(0.3);
Effect.fade_in(1);
wait(1);
Text.set_text(\"Approaching the end of the Crystal Palace, Tux saw Penny's grave, guarded by the Yeti.\");
Text.fade_in(1);
wait(0.9);
Camera.scroll_to(451,698,5.9);
wait(2.7);
Tux.walk(0);
wait(0.5);
Text.fade_out(1);
wait(1.5);
Text.set_text(\"YETI: Tux, do you know the detail everyone missed in the old Legend?\");
Text.fade_in(1);
wait(0.3);
YETI.set_action(\"stomp-left\");
play_sound(\"sounds/yeti_roar.wav\");
YETI.set_velocity(0,-250);
wait(0.3);
YETI.set_action(\"stand-left\");
wait(2.4);
Text.fade_out(1);
wait(2);
Text.set_text(\"YETI: The fact that no ordinary penguin was revived. A Hero was revived.\");
Text.fade_in(1);
wait(0.3);
YETI.set_action(\"stomp-left\");
play_sound(\"sounds/yeti_roar.wav\");
YETI.set_velocity(0,-250);
wait(0.3);
YETI.set_action(\"stand-left\");
wait(1.4);
Camera.scroll_to(880,680,12);
wait(1.5);
Text.fade_out(1);
wait(2);
Text.set_text(\"YETI: You see, Tux, the Crystals dont just revive on a whim, they need energy. Hero Energy.\");
Text.fade_in(1);
wait(0.7);
YETI.set_action(\"stomp-left\");
play_sound(\"sounds/yeti_roar.wav\");
YETI.set_velocity(0,-250);
wait(0.3);
YETI.set_action(\"stand-left\");
wait(2.5);
Text.fade_out(1);
wait(0.5);
play_music(\"music/ghostforest.music\");
wait(1.2);
Text.set_text(\"YETI: And by defeating you, I'll be a Hero. For Nolok, and his in his revival will we spark havoc across the land!\");
Text.fade_in(1);
wait(1.3);
YETI.set_action(\"stomp-left\");
play_sound(\"sounds/yeti_roar.wav\");
YETI.set_velocity(0,-250);
wait(0.4);
YETI.set_action(\"stand-left\");
wait(2);
Tux.walk(150);
wait(0.3);
Camera.scroll_to(700,710,0.5);
wait(0.1);
play_sound(\"sounds/yeti_gna.wav\");
wait(0.9);
Tux.walk(0);
Tux.do_jump(-300);
wait(0.5);
Text.fade_out(1);
wait(1.5);
Text.set_text(\"TUX: No! I'll stop you, for The Meaning of Life is to protect others Lives! I'll defeat you and get my Penny back!\");
Text.fade_in(1);
wait(3.2);
YETI.set_action(\"stomp-left\");
play_sound(\"sounds/yeti_roar.wav\");
YETI.set_velocity(0,-250);
wait(0.3);
YETI.set_action(\"stand-left\");
wait(0.7);
Text.fade_out(1);
wait(1.5);
Text.set_text(\"YETI: Haha! Try, if you can! For You, the Meaning of Life is to Perish! Let us FIGHT!\");
Text.fade_in(1);
stop_music(2);
wait(3.5);
Effect.fade_out(0.5);
wait(0.5);
end_cutscene();
Level.spawn(\"main3\",\"main\");

")
    (ambient-light
      (color 0.7 1 0.8)
    )
    (background
      (color 1 1 1)
      (speed 0.4)
      (image-top "/images/background/ice_cave/darkcave-background.png")
      (image "/images/background/ice_cave/darkcave-background.png")
      (image-bottom "/images/background/ice_cave/darkcave-background.png")
      (z-pos -310)
    )
    (background
      (color 1 1 1)
