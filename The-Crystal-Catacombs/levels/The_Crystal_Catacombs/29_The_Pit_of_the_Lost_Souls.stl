    (scripttrigger
      (width 57.49414)
      (height 16)
      (oneshot #t)
      (script "
Tux.deactivate();
Tux.set_dir(true);
Effect.sixteen_to_nine(1);
end1.start_moving();
wait(2);
Text.set_text(\"Tux looked down to the deep abyss below him and pondered...\");
Text.fade_in(1);
wait(2);
Text.fade_out(1);
wait(1.5);
Tux.set_dir(false);
wait(0.5);
Text.set_text(\"TUX: Penny could be a soul somewhere here... I feel like I am close to saving her somehow.\");
Text.fade_in(1);
wait(3);
Text.fade_out(1);
wait(1.5);
Tux.set_dir(true);
wait(0.5);
Text.set_text(\"TUX: While this place is a beautiful misery, I must continue and find that Yeti.\");
Text.fade_in(1);
stop_music(5);
wait(3);
Text.fade_out(1);
wait(2);
Effect.four_to_three(1);
Tux.activate();
")
