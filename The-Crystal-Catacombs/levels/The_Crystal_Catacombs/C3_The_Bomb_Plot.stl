(supertux-level
  (version 3)
  (name (_ "The Bomb Plot"))
  (author "Alasdair")
  (license "CC-BY-SA 4.0 International")
  (sector
    (name "main")
    (init-script "start_cutscene();
Effect.fade_out(0);
Effect.sixteen_to_nine(0);
Tux.deactivate();
Camera.set_mode(\"scroll\");
Camera.set_pos(10, 350);
YETI.set_action(\"stand-left\");
Camera.scroll_to(360, 380, 6);
Effect.fade_in(1.5);
wait(3);
YETI.set_action(\"stomp-left\");
play_sound(\"sounds/yeti_gna.wav\");
YETI.set_velocity(0, -300);
wait(0.5);
YETI.set_action(\"stand-left\");
Text.set_text(\"While Tux pondered, the Yeti was planning another devious scheme in the distance.\");
Text.fade_in(1);
play_sound(\"sounds/yeti_roar.wav\");
wait(2.5);
YETI.set_action(\"stand-right\");
play_sound(\"sounds/yeti_roar.wav\");
wait(0.25);
YETI.set_action(\"walking-right\");
YETI.set_velocity(250, 0);
wait(0.75);
Text.fade_out(1);
YETI.set_action(\"jump-right\");
YETI.set_velocity(300, -450);
stop_music(7);
wait(1.3);
Effect.fade_out(0.3);
wait(0.5);
play_sound(\"sounds/explosion.wav\");
wait(0.017);
play_sound(\"sounds/explosion.wav\");
wait(0.1);
play_sound(\"sounds/explosion.wav\");
for (local i=0.0;i<100.0;i+=1.0)
{
  local x = (rand()/2147483647.0*64.0-32.0)*(1.0-i/100.0);
  local y = (rand()/2147483647.0*64.0-32.0)*(1.0-i/100.0);
  Camera.shake(0.017, x, y);
  wait(0.017);
}
wait(1);
Text.set_text(\"Or rather, it seemed like the Yeti was up to his usual antics.\");
Text.fade_in(1);
wait(3);
Text.fade_out(1);
wait(2);
end_cutscene();
Level.finish(true);")
    (ambient-light
      (color 0.8 0.8 0.8)
    )
    (background
      (color 1 1 1)
      (speed 0.4)
      (image-top "/images/background/ice_cave/darkcave-background.png")
      (image "/images/background/ice_cave/darkcave-background.png")
      (image-bottom "/images/background/ice_cave/darkcave-background.png")
    )
    (background
