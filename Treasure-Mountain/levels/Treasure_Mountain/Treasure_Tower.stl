    (scripttrigger
      (width 32)
      (height 128)
      (oneshot #t)
      (script "if(state.treasure_keys.earth) {
	if( ! (\"earthopen\" in this)) {
		play_sound(\"sounds/turnkey.ogg\"); // make key sound...
		wait(1);
		EARTHHINT.set_action(\"display\");
		wait(2);
		plat1.goto_node(1);
		this.earthopen <- true;
	}
} else {
	play_sound(\"sounds/locked.ogg\"); 
	// play meep
}
wait(1);
 if(state.treasure_keys.wood) {
	if( ! (\"woodopen\" in this)) {
		play_sound(\"sounds/turnkey.ogg\"); // make key sound...
		wait(1);
		WOODHINT.set_action(\"display\");
		wait(2);
		plat2.goto_node(1);
		this.woodopen <- true;
	}
} else {
	play_sound(\"sounds/locked.ogg\"); 
	// play meep
}
wait(1);
 if(state.treasure_keys.water) {
	if( ! (\"wateropen\" in this)) {
		play_sound(\"sounds/turnkey.ogg\"); // make key sound...
		wait(1);
		WATERHINT.set_action(\"display\");
		wait(2);
		plat3.goto_node(1);
		this.wateropen <- true;
	}
} else {
	play_sound(\"sounds/locked.ogg\"); 
	// play meep
}")
