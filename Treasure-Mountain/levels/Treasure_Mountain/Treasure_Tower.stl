    (scripttrigger
      (width 167.3)
      (height 32)
      (oneshot #t)
      (script "
Tux.deactivate();
wait(1.5);
Effect.sixteen_to_nine(0.15);
wait(0.3);
Text.set_text(_(\"As Tux reached the top of the castle, \\nhe knew he was in danger.\"));
Text.fade_in(0.15);
wait(4);
Text.fade_out(0.15);
wait(1);
Text.set_text(_(\"But he had come all this way...\"));
Text.fade_in(0.15);
wait(4);
Text.fade_out(0.15);
wait(1);
Text.set_text(_(\"And he knew he would be oh so\\nrich if he found the treasure.\"));
Text.fade_in(0.15);
wait(4);
Text.fade_out(0.15);
wait(1);
Effect.four_to_three(0.3);
Tux.activate();
")
      (button #f)
      (x 800)
      (y 2048)
    )
    (scripttrigger
      (width 160)
      (height 32)
      (oneshot #t)
      (script "starrt.goto_node(1);
Text.set_text(_(\"Current Objective:\\nSURVIVE!!!\"));
Text.fade_in(0.15);
wait(3);
Text.fade_out(0.15);
station1.goto_node(1);
wait(0.5);
station2.goto_node(1);
wait(0.5);
station3.goto_node(1);
wait(2);
spiketrap.fade(1, 0.15);
sidel.goto_node(1);
sider.goto_node(1);
wait(20);
sidel.goto_node(0);
sider.goto_node(0);
wait(5);
lefthurt1.start_moving();
lefthurt2.start_moving();
lefthurt3.start_moving();
wait(0.5);
righthurt1.start_moving();
righthurt2.start_moving();
righthurt3.start_moving();
wait(20);
lefthurt1.stop_moving();
lefthurt2.stop_moving();
lefthurt3.stop_moving();
wait(0.5);
righthurt1.stop_moving();
righthurt2.stop_moving();
righthurt3.stop_moving();
wait(4);
spiketrap.fade(1, 0.15);
station1.goto_node(2);
station2.goto_node(2);
station3.goto_node(2);
wait(1.75);
dip1.goto_node(1);
dip2.goto_node(1);
dip3.goto_node(1);
dip4.goto_node(1);
dip5.goto_node(1);
dip6.goto_node(1);
dip7.goto_node(1);
dip8.goto_node(1);
wait(5);
sidel.goto_node(1);
sider.goto_node(1);
wait(10);
crushl.start_moving();
crushr.start_moving();
lefthurt1.start_moving();
lefthurt2.start_moving();
lefthurt3.start_moving();
wait(0.5);
righthurt1.start_moving();
righthurt2.start_moving();
righthurt3.start_moving();
wait(30);
sidel.goto_node(0);
sider.goto_node(0);
wait(1);
crushl.stop_moving();
crushr.stop_moving();
