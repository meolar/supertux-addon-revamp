(supertux-level
  (version 3)
  (name (_ "The Snow Shop"))
  (author "Skittles")
  (license "CC-BY-SA 4.0 International")
  (sector
    (name "main")
    (init-script "import(\"levels/Skitt_land/key.nut\");")
    (ambient-light
      (color 0.7 0.6 0.8)
    )
    (background
      (color 1 1 1)
      (speed 0.5)
      (image "/images/background/antarctic/misty_snowhills_small.png")
    )
    (camera
      (name "Camera")
      (mode "normal")
    )
    (candle
      (color 1 0 0)
      (layer -20)
      (x 1072)
      (y 704)
    )
    (candle
      (color 0 1 1)
      (layer -20)
      (x 944)
      (y 704)
    )
    (candle
      (color 0 1 0)
      (layer -20)
      (x 864)
      (y 704)
    )
    (candle
      (color 1 1 0)
      (layer -20)
      (x 784)
      (y 704)
    )
    (decal
      (z-pos -10)
      (sprite "/images/powerups/fireflower/fire_flower-0.png")
      (x 1072)
      (y 704)
    )
    (decal
      (z-pos -10)
      (sprite "/images/powerups/airflower/air_flower-0.png")
      (x 784)
      (y 704)
    )
    (decal
      (z-pos -10)
      (sprite "/images/powerups/earthflower/earth_flower-0.png")
      (x 864)
      (y 704)
    )
    (decal
      (z-pos -10)
      (sprite "/images/powerups/iceflower/ice_flower-0.png")
      (x 944)
      (y 704)
    )
    (decal
      (z-pos -10)
      (sprite "/images/decal/misc/Antena2.png")
      (x 1056)
      (y 256)
    )
    (gradient
      (top_color 0.6 0.1 0)
      (bottom_color 0 0 0 0)
      (z-pos -299)
    )
    (infoblock
      (message (_ "-Air Flower
 $100 
*-Ideal for Speedruns of levels
*-Upgrades your Speed and Jumping
*-You can glide in the air for a while"))
      (x 784)
      (y 736)
    )
    (infoblock
      (message (_ "-Earth Flower
 $200
*-Ideal for Dark levels
*-You have a lantern that lights the way
*-Convert you into stone ability"))
      (x 864)
      (y 736)
    )
    (infoblock
      (message (_ "-Fire Flower
 $300
*-Ideal for any level
*-You can shoot fireballs
*-This power is cumulative"))
      (x 1072)
      (y 736)
    )
    (infoblock
      (message (_ "-Ice Flower
 $250
*-Ideal for levels with Metal Enemies
*-You can shoot iceballs that ice enemies
*-This power is cumulative"))
      (x 944)
      (y 736)
    )
    (infoblock
      (message (_ "-Welcome to the Shop
Here you can buy powerups that requires coins that you can get on any level.
 Also we make this shop for give an function to the coins lol"))
      (x 640)
      (y 736)
    )
    (music
      (file "misc\\bonuscave.music")
    )
    (particles-snow
    )
    (scripttrigger
      (width 32)
      (height 32)
      (script "Tux.do_jump(-700);")
      (button #f)
      (x 128)
      (y 832)
    )
    (scripttrigger
      (width 32)
      (height 96)
      (oneshot #t)
      (script "sector.settings.fade_to_ambient_light(1, 0.85, 0.9, 1);")
      (button #f)
      (x 576)
      (y 768)
    )
    (sequencetrigger
      (sequence "endsequence")
      (width 32)
      (height 96)
      (x 576)
      (y 768)
    )
    (sequencetrigger
      (sequence "stoptux")
      (width 32)
      (height 832)
      (x 0)
      (y 0)
    )
    (spawnpoint
      (name "main")
      (x 672)
      (y 800)
    )
    (switch
      (script "if(Tux.get_coins() >= 100){
Tux.add_coins(-100);
Tux.add_bonus(\"airflower\");
}")
      (sprite "/images/objects/switch/switch.sprite")
      (x 784)
      (y 624)
    )
    (switch
      (script "if(Tux.get_coins() >= 200){
Tux.add_coins(-200);
Tux.add_bonus(\"earthflower\");
}")
      (sprite "/images/objects/switch/switch.sprite")
      (x 864)
      (y 624)
