(supertux-level
  (version 3)
  (name (_ "In Front of Yeti's Castle"))
  (author "Skittles")
  (license "CC-BY-SA 4.0 International")
  (sector
    (name "main")
    (init-script "import(\"levels/Skitt_land/key.nut\");
KEYHINT.set_action(\"outline\");")
    (ambient-light
      (color 0.7 0.9 1)
    )
    (background
      (color 1 1 1)
      (speed 0.5)
      (image "/images/background/antarctic/misty_snowhills_small.png")
    )
    (camera
      (name "Camera")
      (mode "normal")
    )
    (gradient
      (top_color 0 0 0.3)
      (bottom_color 0 0 0 0)
      (z-pos -299)
    )
    (infoblock
      (message (_ "-Have you already got the Key?
#If you get it, you can enter to the Castle, in case you didn't get it you must to search it."))
      (x 1184)
      (y 512)
    )
    (music
      (file "forest\\forest3.music")
    )
    (particles-snow
      (z-pos -201)
    )
    (path
      (name "gen16651728291759732223616")
      (path
        (mode "oneshot")
