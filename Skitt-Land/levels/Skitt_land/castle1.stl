      (physic-enabled #f)
      (solid #f)
      (name "KEYHINT")
      (sprite "/images/objects/keys/key_air.sprite")
      (x 1408)
      (y 368)
    )
    (scripttrigger
      (width 96)
      (height 192)
      (script "if(state.key_items.key) {
if( ! (\"open\" in this)) {
play_sound(\"sounds/turnkey.ogg\");
wait(1);
KEYHINT.set_action(\"display\");
wait(2);
door.goto_node(1);
this.open <- true;
}
} else {
play_sound(\"sounds/locked.ogg\");
}")
      (button #f)
      (x 1376)
      (y 448)
    )
    (scripttrigger
      (width 32)
      (height 192)
      (script "start_cutscene();
Tux.deactivate();
Effect.sixteen_to_nine(2);
Tux.walk(150);
wait(3);
Effect.fade_out(2);
wait(2.1);
end_cutscene();
Level.finish(true);")
