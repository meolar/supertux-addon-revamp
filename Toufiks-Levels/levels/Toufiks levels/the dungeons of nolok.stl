      (script "Tux.deactivate();
wait(1.5);

play_music(\"music/misc/leveldone.ogg\");
play_sound(\"speech/penny_runt_01.ogg\");
Text.set_text(\"       Thank you Tux ! \\nBut our penguin is in another castle.\");
