(supertux-level
  (version 3)
  (name (_ "The ShowRoom"))
  (author "TOUFIK")
  (license "GPL 2+ / CC-by-sa 3.0")
  (sector
    (name "main")
    (ambient-light
      (color 0.4114901 0.4114901 0.4114901)
    )
    (camera
      (name "Camera")
      (mode "normal")
    )
    (infoblock
      (message (_ "-Ice Apple
!images/toufik/powerups/iceapple/apple.png
#Ice Apple gives to Tux 100 Gold Pieces !  

-Rainbow Apple
!images/toufik/powerups/apple/apple.png
#Rainbow Apple gives to Tux 100 Gold Pieces !  

-Secret Star
!images/toufik/powerups/star/star.png
#Secret Star gives to Tux 1000 Gold Pieces !  "))
      (x 480)
      (y 544)
    )
    (infoblock
      (message (_ "-Sea Creatures
 You can't kill them because they are dangerous...
#Glooby
!images/toufik/ennemies/glooby/glooby.png
#GloobyFast
!images/toufik/ennemies/glooby/gloobyfast.png
#Fishy Fishy
!images/toufik/ennemies/fishy/fishy.png
#GloobyKing
!images/toufik/ennemies/glooby/gloobykingsmall.gif
 (The Boss)"))
      (x 608)
      (y 544)
    )
    (infoblock
      (message (_ "-Welcome to The showroom
 This wonderful Worldmap contains a lot of new things like a new powerups and ennemies which are designed by me  !
 You should see the InfoBlocks for more informations."))
      (x 224)
      (y 544)
    )
    (infoblock
      (message (_ "-Subys
 (a Volcano creatures)
 You can kill them with fireballs or freeze them with iceballs.
 Warning : don't touch them !! 
#Suby
!images/toufik/ennemies/subby/subbytoufik1.png
#Suby (iced) 
!images/toufik/ennemies/subby/iced-left.png"))
      (x 672)
      (y 544)
    )
    (infoblock
      (message (_ " Hi adventurer , Welcome to Toufik's levels !

 Most of them were designed to be a challenge for advanced players, but usually the player should be able to avoid their traps once he knows they're there. There is two types of levels : 

 - Normal levels : like a story, Play levels, rescue  penguins.

 - Challenge levels : they are locked at the beginning .If you want to unlock them, you must finish the worldmap at first.

 Enjoy Toufik's levels -Toufik- ;)"))
      (x 480)
      (y 448)
    )
