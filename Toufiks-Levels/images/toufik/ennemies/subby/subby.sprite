(supertux-sprite
  (action
    (name "left")
    (hitbox 3 4 32 32)
    (images "subbytoufik0.png"
            "subbytoufik1.png"
            "subbytoufik2.png"
            "subbytoufik1.png"))
  (action
    (name "right")
    (hitbox 3 4 32 32)
    (mirror-action "left"))

 (action
  (name "iced-left")
  (hitbox 3 4 32 32)
  (images "iced-left.png"))
 (action
  (name "iced-right")
  (hitbox 3 4 32 32)
  (mirror-action "iced-left"))
 
 (action
  (name "left-up")
  (hitbox 3 4 32 32)
  (images "subbytoufik1.png"))
 
 (action
  (name "right-up")
  (hitbox 3 4 32 32)
  (mirror-action "left-up"))
 
 (action
  (name "left-down")
  (hitbox 3 4 32 32)
  (images "subbytoufik1.png"))

 (action
  (name "left-iced")
  (hitbox 3 4 32 32)
  (images "iced-left.png"))
 
 (action
  (name "right-iced")
  (hitbox 3 4 32 32)
  (mirror-action "left-iced"))
)
