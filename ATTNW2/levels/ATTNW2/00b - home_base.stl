    (infoblock
      (message (_ "-Welcome to Supertux: Adventure to the New World 2! If you've played ATTNW1, you should know what to expect from these levels. If not, read on."))
      (x 192)
      (y 480)
    )
    (infoblock
      (message (_ "-This levelset is intended for experienced Supertux players and will be rather difficult at times. Beginners, consider yourselves warned."))
      (x 512)
      (y 448)
    )
    (infoblock
      (message (_ "-This time, there will be 23 levels in three worlds to make it through."))
      (x 672)
      (y 448)
    )
    (infoblock
      (message (_ "-To pay tribute to the original ATTNW, no levels will contain checkpoints, except where necessary to keep them from getting ridiculously difficult."))
      (x 928)
      (y 288)
    )
    (infoblock
      (message (_ "-Ready to get started? There's plenty of treasure to collect, so get out there and find it!"))
