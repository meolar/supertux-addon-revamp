release3.goto_node(0);
release4.goto_node(0);
wood4.goto_node(0);
wood5.goto_node(0);
wood6.goto_node(0);
play_music(\"music/misc/battle_theme.ogg\");
castlefade <- false;
switching.set_alpha(1);
switching2.set_alpha(1);
}")
