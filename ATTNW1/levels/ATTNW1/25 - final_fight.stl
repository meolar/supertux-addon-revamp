    (name "main")
    (init-script "castlefade <- true
	while(castlefade)
		{
			wait(4);
			switching.fade(0.1,2);
			switching2.fade(1,2);
			wait(4);
			switching.fade(1,2);
			switching2.fade(0.1,2);
		}
")
