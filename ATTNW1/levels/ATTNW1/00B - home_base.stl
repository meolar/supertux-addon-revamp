    (infoblock
      (message (_ "-Welcome to Adventure to the New World, Tux's most challenging journey yet!"))
      (x 128)
      (y 800)
    )
    (infoblock
      (message (_ "-This levelset is designed for experienced Supertux players who have a good knowledge of Supertux mechanics. If you've just started playing Supertux, these may not be the levels for you."))
      (x 384)
      (y 800)
    )
    (infoblock
      (message (_ "-This levelset will be rather difficult at times, so make wise use of your powerups and lives. You'll need all your Supertux skills to make it to Nolok's fortress."))
      (x 640)
      (y 800)
    )
    (infoblock
      (message (_ "-In addition, hardly any levels contain checkpoints. This is to keep the feel of the original Adventure to the New World. Most of the levels are fairly short, so this shouldn't be a problem."))
      (x 1280)
      (y 768)
    )
    (infoblock
      (message (_ "-Ready to do this? Penny is counting on you, so good luck and have fun!"))
      (x 1760)
      (y 640)
